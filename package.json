{
  "name": "old-macdonald-had-a-school",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "content:validate": "node scripts/content/validate.mjs",
    "qa:visual": "npm run build && playwright test --config=playwright.visual.config.ts",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "db:generate": "drizzle-kit generate --config=drizzle.sqlite.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.sqlite.config.ts",
    "db:push": "drizzle-kit push --config=drizzle.sqlite.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.sqlite.config.ts",
    "db:evaluate-search": "node scripts/data/evaluate-sqlite-retrieval.mjs data/omhas.db --summary",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.0",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@types/mdx": "^2.0.14",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "lightningcss": "^1.33.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "^5.5.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "lightningcss-win32-x64-msvc": "^1.33.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@xenova/transformers": "^2.17.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "storybook": "^10.5.7",
    "@storybook/nextjs-vite": "^10.5.7",
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-mcp": "latest",
    "vite": "latest",
    "eslint-plugin-storybook": "^10.5.7",
    "vitest": "latest",
    "playwright": "latest",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest"
  },
  "type": "module"
